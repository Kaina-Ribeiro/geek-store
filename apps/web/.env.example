# ─── Base ────────────────────────────────────────────────────────────────
# Dev: Postgres do docker-compose.yml (pnpm db:up). Produção: Neon, ex. postgres://user:senha@host/db?sslmode=require
DATABASE_URL=postgres://checkpoint:checkpoint@127.0.0.1:5434/checkpoint
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PAYLOAD_SECRET=troque-isto
# Endereço público do site (links dos e-mails, webhook, sitemap). Em produção: https://checkpointgeek.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ─── Mercado Pago (Pix e cartão) ─────────────────────────────────────────
# Sem estas chaves, o checkout roda em modo de simulação (só fora de produção).
# Credenciais de teste começam com TEST-. Painel: Suas integrações > Credenciais.
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Assinatura secreta do webhook (Suas integrações > Webhooks). URL: <site>/webhooks/mercadopago
MP_WEBHOOK_SECRET=

# ─── Melhor Envio (frete) ────────────────────────────────────────────────
# Sem token, usa uma tabela de frete aproximada por região.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=1
STORE_ORIGIN_CEP=12010000

# ─── E-mail (Resend) ─────────────────────────────────────────────────────
# Sem chave, os e-mails aparecem no log do servidor (e o link de login na tela).
RESEND_API_KEY=
EMAIL_FROM=pedidos@checkpointgeek.com.br
# Quem recebe o aviso de pedido pago
STORE_NOTIFY_EMAIL=

# ─── Tarefa agendada (expirar Pix, aviso de drop) ────────────────────────
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" para /webhooks/cron.
CRON_SECRET=

# ─── Fotos em produção (Cloudflare R2, API S3) ───────────────────────────
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Dados da loja (aparecem no rodapé e nas páginas legais) ─────────────
NEXT_PUBLIC_STORE_LEGAL_NAME=
NEXT_PUBLIC_STORE_CNPJ=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_HOURS=Seg a sáb · 10h às 19h
NEXT_PUBLIC_STORE_EMAIL=contato@checkpointgeek.com.br
# Só números, com DDI: 5512999999999
NEXT_PUBLIC_WHATSAPP=

# ─── Métricas (carregam só depois do aceite de cookies) ──────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
